[Unit]
Description=micro-ROS agent for the OBot CYD display (UDP 8888, ROS_DOMAIN_ID=5)
After=network-online.target

[Service]
Type=simple
Environment=ROS_DOMAIN_ID=5
Environment=RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
Environment=CYCLONEDDS_URI=file://%h/cyclonedds_wifi.xml
ExecStart=/bin/bash -c 'source /opt/ros/jazzy/setup.bash && source %h/Workspaces/uros_ws/install/local_setup.bash && exec ros2 run micro_ros_agent micro_ros_agent udp4 --port 8888'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
